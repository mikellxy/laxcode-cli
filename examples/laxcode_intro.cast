[0.019, "o", "\r\u001b[3B\n\u001b[4A\u001b[L\u001b[0m\u001b[32m简\u001b[0m\u001b[32m言之\u001b[0m\u001b[32m，\u001b[0m\u001b[32mL\u001b[0m\u001b[32max\u001b[0m\u001b[32mCode\u001b[0m\u001b[32m \u001b[0m\u001b[32m是一个\u001b[0m\u001b[32m结构\u001b[0m\u001b[32m清晰\u001b[0m\u001b[32m、\u001b[0m\u001b[32m可\u001b[0m\u001b[32m观测\u001b[0m\u001b[32m、\u001b[0m\u001b[32m可\u001b[0m\u001b[32m扩展\u001b[0m\u001b[32m的\u001b[0m\u001b[32m Go\u001b[0m\u001b[32m Agent\u001b[0m\u001b[32m \u001b[0m\u001b[32m引擎\u001b[0m\u001b[32m，\u001b[0m\u001b[32m适合\u001b[0m\u001b[32m学习\u001b[0m\u001b[32m Agent\u001b[0m\u001b[32m \u001b[0m\u001b[32m实现\u001b[0m\u001b[32m原理\u001b[0m\u001b[32m或\u001b[0m\u001b[32m作为\u001b[0m\u001b[32m二次\u001b[0m\u001b[32m开发\u001b[0m\u001b[32m底座\u001b[0m\u001b[32m。\u001b[0m\u001b[0m\u001b[K\r\n"]
